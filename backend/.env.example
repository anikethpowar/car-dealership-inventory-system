APP_NAME=Car Dealership Inventory System API
APP_VERSION=0.1.0
DATABASE_URL=sqlite:///dealership.db
FRONTEND_ORIGIN=http://localhost:5173

# JWT signing key — replace with a long random string in production
SECRET_KEY=change-this-to-a-secure-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Legacy aliases (kept for backward compatibility)
JWT_SECRET_KEY=change-this-to-a-secure-random-secret
JWT_ALGORITHM=HS256

# Admin seed account — used by: python -m scripts.seed_admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=AdminPass123!
